{
  "name": "moepush",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && python3 -m unittest discover -s tests -p '*_test.py'",
    "pages:build": "pnpm next-on-pages",
    "preview": "pnpm pages:build && wrangler pages dev",
    "deploy": "pnpm pages:build && wrangler pages deploy .vercel/output/static --branch preview --no-bundle",
    "deploy:prod": "pnpm pages:build && wrangler pages deploy .vercel/output/static --branch main --no-bundle",
    "db:migrate-local": "pnpm drizzle-kit generate && pnpm wrangler d1 migrations apply moepush --local",
    "tunnel": "pnpm dlx cloudflared tunnel --url http://localhost:3000"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "lucide-react": "^0.474.0",
    "nanoid": "^5.1.16",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1",
    "@cloudflare/workers-types": "^4.20250204.0",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.20.3",
    "typescript": "^5",
    "vercel": "^41.0.2",
    "wrangler": "^3.107.3"
  },
  "pnpm": {
    "overrides": {
      "nanoid@^3.0.0": "3.3.18",
      "nanoid@^5.0.0": "5.1.16",
      "postcss": "8.5.29",
      "source-map-js": "1.2.2"
    }
  }
}
